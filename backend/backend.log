query: SELECT "ns"."nspname" AS "table_schema", "t"."relname" AS "table_name", "i"."relname" AS "constraint_name", "a"."attname" AS "column_name", CASE "ix"."indisunique" WHEN 't' THEN 'TRUE' ELSE'FALSE' END AS "is_unique", pg_get_expr("ix"."indpred", "ix"."indrelid") AS "condition", "types"."typname" AS "type_name", "am"."amname" AS "index_type" FROM "pg_class" "t" INNER JOIN "pg_index" "ix" ON "ix"."indrelid" = "t"."oid" INNER JOIN "pg_attribute" "a" ON "a"."attrelid" = "t"."oid"  AND "a"."attnum" = ANY ("ix"."indkey") INNER JOIN "pg_namespace" "ns" ON "ns"."oid" = "t"."relnamespace" INNER JOIN "pg_class" "i" ON "i"."oid" = "ix"."indexrelid" INNER JOIN "pg_type" "types" ON "types"."oid" = "a"."atttypid" INNER JOIN "pg_am" "am" ON "i"."relam" = "am"."oid" LEFT JOIN "pg_constraint" "cnst" ON "cnst"."conname" = "i"."relname" WHERE "t"."relkind" IN ('r', 'p') AND "cnst"."contype" IS NULL AND (("ns"."nspname" = 'public' AND "t"."relname" = 'agencies') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'users') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_members') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'freelancer_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'client_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'notifications') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'portfolios') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'categories') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'projects') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'bids') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'contracts') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'conversations') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'project_skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'bid_mile