query: SELECT columns.*, pg_catalog.col_description(('"' || table_catalog || '"."' || table_schema || '"."' || table_name || '"')::regclass::oid, ordinal_position) AS description, ('"' || "udt_schema" || '"."' || "udt_name" || '"')::"regtype"::text AS "regtype", pg_catalog.format_type("col_attr"."atttypid", "col_attr"."atttypmod") AS "format_type" FROM "information_schema"."columns" LEFT JOIN "pg_catalog"."pg_attribute" AS "col_attr" ON "col_attr"."attname" = "columns"."column_name" AND "col_attr"."attrelid" = ( SELECT "cls"."oid" FROM "pg_catalog"."pg_class" AS "cls" LEFT JOIN "pg_catalog"."pg_namespace" AS "ns" ON "ns"."oid" = "cls"."relnamespace" WHERE "cls"."relname" = "columns"."table_name" AND "ns"."nspname" = "columns"."table_schema" ) WHERE ("table_schema" = 'public' AND "table_name" = 'agencies') OR ("table_schema" = 'public' AND "table_name" = 'users') OR ("table_schema" = 'public' AND "table_name" = 'agency_profiles') OR ("table_schema" = 'public' AND "table_name" = 'agency_members') OR ("table_schema" = 'public' AND "table_name" = 'freelancer_profiles') OR ("table_schema" = 'public' AND "table_name" = 'client_profiles') OR ("table_schema" = 'public' AND "table_name" = 'notifications') OR ("table_schema" = 'public' AND "table_name" = 'portfolios') OR ("table_schema" = 'public' AND "table_name" = 'categories') OR ("table_schema" = 'public' AND "table_name" = 'projects') OR ("table_schema" = 'public' AND "table_name" = 'skills') OR ("table_schema" = 'public' AND "table_name" = 'bids') OR ("table_schema" = 'public' AND "table_name" = 'contracts') OR ("table_schema" = 'public' AND "table_name" = 'conversations') OR ("table_schema" = 'public' AND "table_name" = 'agency_skills') OR ("table_schema" = 'public' AND "table_name" = 'project_skills') OR ("table_schema" = 'public' AND "table_name" = 'bid_milestones') OR ("table_schema" = 'public' AND "table_name" = 'payments') OR ("table_schema" = 'public' AND "table_name" = 'time_logs') OR ("table_schema" = 'public' 