query: SELECT "con"."conname" AS "constraint_name", "con"."nspname" AS "table_schema", "con"."relname" AS "table_name", "att2"."attname" AS "column_name", "ns"."nspname" AS "referenced_table_schema", "cl"."relname" AS "referenced_table_name", "att"."attname" AS "referenced_column_name", "con"."confdeltype" AS "on_delete", "con"."confupdtype" AS "on_update", "con"."condeferrable" AS "deferrable", "con"."condeferred" AS "deferred" FROM ( SELECT UNNEST ("con1"."conkey") AS "parent", UNNEST ("con1"."confkey") AS "child", "con1"."confrelid", "con1"."conrelid", "con1"."conname", "con1"."contype", "ns"."nspname", "cl"."relname", "con1"."condeferrable", CASE WHEN "con1"."condeferred" THEN 'INITIALLY DEFERRED' ELSE 'INITIALLY IMMEDIATE' END as condeferred, CASE "con1"."confdeltype" WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET NULL' WHEN 'd' THEN 'SET DEFAULT' END as "confdeltype", CASE "con1"."confupdtype" WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET NULL' WHEN 'd' THEN 'SET DEFAULT' END as "confupdtype" FROM "pg_class" "cl" INNER JOIN "pg_namespace" "ns" ON "cl"."relnamespace" = "ns"."oid" INNER JOIN "pg_constraint" "con1" ON "con1"."conrelid" = "cl"."oid" WHERE "con1"."contype" = 'f' AND (("ns"."nspname" = 'public' AND "cl"."relname" = 'agencies') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'users') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'agency_profiles') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'agency_members') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'freelancer_profiles') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'client_profiles') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'notifications') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'portfolios') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'categories') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'projects') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'skills') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'bids') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'contracts') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'conversations') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'agency_skills') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'project_skills') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'bid_milestones') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'payments') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'time_logs') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'invoices') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'disputes') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'messages') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'conversation_participants') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'reviews') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'freelancer_skills') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'milestones') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'portfolio_skills') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'milestone_submissions') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'invoice_items') OR ("ns"."nspname" = 'public' AND "cl"."relname" = 'dispute_messages')) ) "con" INNER JOIN "pg_attribute" "att" ON "att"."attrelid" = "con"."confrelid" AND "att"."attnum" = "con"."child" INNER JOIN "pg_class" "cl" ON "cl"."oid" = "con"."confrelid"  AND "cl"."relispartition" = 'f'INNER JOIN "pg_namespace" "ns" ON "cl"."relnamespace" = "ns"."oid" INNER JOIN "pg_attribute" "att2" ON "att2"."attrelid" = "con"."conrelid" AND "att2"."attnum" = "con"."parent"
