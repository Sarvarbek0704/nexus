query: SELECT "ns"."nspname" AS "table_schema", "t"."relname" AS "table_name", "cnst"."conname" AS "constraint_name", pg_get_constraintdef("cnst"."oid") AS "expression", CASE "cnst"."contype" WHEN 'p' THEN 'PRIMARY' WHEN 'u' THEN 'UNIQUE' WHEN 'c' THEN 'CHECK' WHEN 'x' THEN 'EXCLUDE' END AS "constraint_type", "a"."attname" AS "column_name" FROM "pg_constraint" "cnst" INNER JOIN "pg_class" "t" ON "t"."oid" = "cnst"."conrelid" INNER JOIN "pg_namespace" "ns" ON "ns"."oid" = "cnst"."connamespace" LEFT JOIN "pg_attribute" "a" ON "a"."attrelid" = "cnst"."conrelid" AND "a"."attnum" = ANY ("cnst"."conkey") WHERE "t"."relkind" IN ('r', 'p') AND (("ns"."nspname" = 'public' AND "t"."relname" = 'agencies') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'users') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_members') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'freelancer_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'client_profiles') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'notifications') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'portfolios') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'categories') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'projects') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'bids') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'contracts') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'conversations') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agency_skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'project_skills') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'bid_milestones') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'payments') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'time_logs') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'invoices') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'disputes') O